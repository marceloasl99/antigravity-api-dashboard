# Antigravity CLI Binary Path
AGY_BINARY=/root/.local/bin/agy

# API Service Configuration
PORT=8080
AGY_POOL_SIZE=4
AGY_POOL_TIMEOUT=30

# Dashboard Configuration
DASHBOARD_PORT=80
API_BASE=http://127.0.0.1:8080
DEBUG=false

# Optional Profile Config file
PROFILES_CONFIG=profiles.json

# Fallback Profiles configuration (if profiles.json is not used)
P1_NAME=Perfil 1
P1_EMAIL=conta1@gmail.com
P1_HOME=/root

P2_NAME=Perfil 2
P2_EMAIL=conta2@gmail.com
P2_HOME=/root/.agy-perfil2

P3_NAME=Perfil 3
P3_EMAIL=conta3@gmail.com
P3_HOME=/root/.agy-perfil3
