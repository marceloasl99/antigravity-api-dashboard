# Antigravity CLI Binary Path
AGY_BINARY=/root/.local/bin/agy

# API Service Configuration
PORT=8080
CONFIG_FILE=/root/agy_config.json

# Dashboard Configuration
DASHBOARD_PORT=80
API_BASE=http://127.0.0.1:8080
DEBUG=false

# Optional Profile Config file
PROFILES_CONFIG=profiles.json

# IMPORTANT: each profile "home" must be a CLEAN directory dedicated to the gateway.
# A HOME with your interactive agy config (MCP servers, plugins, hooks) adds ~33 s per request.
AGY_AGENT=gateway            # custom agent written into each profile home; empty = CLI default agent (tool calling breaks)

# Warm process pool (v3)
AGY_POOL_ENABLED=true        # false = one cold agy process per request (v2 behaviour)
AGY_POOL_SIZE=2              # warm processes kept per (account, model); each idle process costs ~3 s to start and ~100 MB RAM
AGY_POOL_MAX_IDLE=600        # seconds before an idle warm process is recycled
AGY_INIT_TIMEOUT=60          # seconds to wait for the CLI "init" event
AGY_TURN_TIMEOUT=180         # seconds per request
AGY_CWD=/tmp                 # working directory given to the CLI
# AGY_COMMAND="python tests/fake_agy.py"   # override the whole command (tests / debugging)
# DEBUG=true writes request bodies and call logs to $DEBUG_LOG_DIR (default: AGY_CWD)

# Fallback Profiles configuration (if profiles.json is not used)
P1_NAME=Profile 1
P1_EMAIL=account1@example.com
P1_HOME=/root

P2_NAME=Profile 2
P2_EMAIL=account2@example.com
P2_HOME=/root/.agy-perfil2

P3_NAME=Profile 3
P3_EMAIL=account3@example.com
P3_HOME=/root/.agy-perfil3
